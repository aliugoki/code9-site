# ── Secrets & local state ────────────────────────────────────────
.env
backups/

# ── WordPress runtime (managed on the server, not in git) ─────────
# Core, third-party plugins, themes and uploads are restored from the
# backup and edited via wp-admin — they are intentionally NOT versioned.
wordpress/

# ── Database dumps ───────────────────────────────────────────────
db/*.sql
db/*.sql.gz

# ── Self-hosted runner (lives outside the repo anyway) ───────────
actions-runner/

# ── OS / editor noise ────────────────────────────────────────────
.DS_Store
*.swp
*~
